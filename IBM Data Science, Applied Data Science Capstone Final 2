import requests
from bs4 import BeautifulSoup
import pandas as pd
import unicodedata

def date_time(table_cells): return [data_time.strip() for data_time in list(table_cells.strings)][0:2]
def booster_version(table_cells): return ''.join([bv for i,bv in enumerate(table_cells.strings) if i%2==0][0:-1])
def landing_status(table_cells): return [i for i in table_cells.strings][0]
def get_mass(table_cells):
    mass=unicodedata.normalize("NFKD", table_cells.text).strip()
    return mass[0:mass.find("kg")+2] if mass and "kg" in mass else 0
def extract_column_from_header(row):
    if (row.br): row.br.extract()
    if row.a: row.a.extract()
    if row.sup: row.sup.extract()
    colunm_name = ' '.join(row.contents)
    if not(colunm_name.strip().isdigit()): return colunm_name.strip()

static_url = "https://en.wikipedia.org/w/index.php?title=List_of_Falcon_9_and_Falcon_Heavy_launches&oldid=1027686922"
response = requests.get(static_url)
soup = BeautifulSoup(response.text, 'html.parser')

first_launch_table = soup.find_all('table')[2]
column_names = []
for th in first_launch_table.find_all('th'):
    name = extract_column_from_header(th)
    if name is not None and len(name) > 0: column_names.append(name)

launch_dict = {name: [] for name in column_names}
for col in ['Version Booster', 'Booster landing', 'Date', 'Time']: launch_dict[col] = []

for table in soup.find_all('table', "wikitable plainrowheaders collapsible"):
    for rows in table.find_all("tr"):
        if rows.th and rows.th.string:
            flight_number = rows.th.string.strip()
            if flight_number.isdigit():
                row = rows.find_all('td')
                launch_dict['Flight No.'].append(flight_number)
                dt_list = date_time(row[0])
                launch_dict['Date'].append(dt_list[0].strip(','))
                launch_dict['Time'].append(dt_list[1])
                launch_dict['Version Booster'].append(booster_version(row[1]))
                launch_dict['Launch site'].append(row[2].a.string if row[2].a else None)
                launch_dict['Payload'].append(row[3].a.string if row[3].a else None)
                launch_dict['Payload mass'].append(get_mass(row[4]))
                launch_dict['Orbit'].append(row[5].a.string if row[5].a else None)
                # Customer 에러 방지 (if 조건 추가)
                launch_dict['Customer'].append(row[6].a.string if row[6] and row[6].a else None)
                launch_dict['Launch outcome'].append(list(row[7].strings)[0] if row[7] else None)
                launch_dict['Booster landing'].append(landing_status(row[8]) if row[8] else None)

df = pd.DataFrame({ key:pd.Series(value) for key, value in launch_dict.items() })
df.head()
